# Developer convenience only: read when running from source (npm start). The installed app is configured in Settings > Connections.
# Environment variables take precedence over values saved in the app.
APP_ID=
KEY_PATH=./your-application-id.pem
ALPHAVANTAGE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BACKUP_PASSPHRASE=
# PENNYSTEAD_PORT=3456            # the redirect URL to register with Enable Banking is http://localhost:<port>/callback
# PENNYSTEAD_PASSWORD=            # required if you set PENNYSTEAD_HOST to anything other than localhost
# MCP: REDACT=light|full|off  MCP_WRITE=1
